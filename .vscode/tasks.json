{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile-java",
            "type": "shell",
            "command": "javac",
            "args": [
                "--release", "8",
                "-d", "${workspaceFolder}/client/target/classes",
                "-encoding", "UTF-8",
                "${workspaceFolder}/client/Main.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
